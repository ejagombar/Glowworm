# Nightly Glowworm backup: sudo systemctl enable --now glowworm-backup@ed.timer
[Unit]
Description=Nightly Glowworm backup (as %i)

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15m
# A night missed while the server was off runs at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
